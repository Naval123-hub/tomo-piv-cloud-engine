# Copy to `.env`. Read by BOTH halves of this server:
#   - the Node gateway  (src/config.js)
#   - the Python worker (cloud_io.load_dotenv_if_present)
# In the cloud the same names come from the Modal secret `tomo-piv-secrets`,
# so nothing in the code branches on where it is running.

# --- Node gateway ----------------------------------------------------------
PORT=5000
# Origins allowed to call this API (the Vite dev server proxies instead)
CORS_ORIGIN=http://localhost:5173
# Presigned URL lifetime, seconds
URL_TTL_SECONDS=3600

# --- Modal GPU worker ------------------------------------------------------
# Deployed FastAPI URL from `modal deploy app_modal.py`
MODAL_API_URL=https://<workspace>--tomo-piv-fastapi-app.modal.run
# Bearer token for that API. Blank = the API is OPEN; set it before exposing
# the deployed URL publicly.
API_AUTH_TOKEN=

# --- Cloudflare R2 (S3-compatible object storage) --------------------------
# Endpoint is the S3 API URL from the R2 dashboard, NOT the public bucket URL:
CLOUDFLARE_R2_ENDPOINT="https://7486defaeb0bb73c59235d015a038638.r2.cloudflarestorage.com"

CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_BUCKET=tomo-piv
# Optional. Set only if the bucket is public (an r2.dev subdomain or a custom
# domain); artifact links then become permanent public URLs instead of
# short-lived presigned ones.
# CLOUDFLARE_R2_PUBLIC_URL=https://pub-<hash>.r2.dev

# --- Job queue / cache -----------------------------------------------------
# Upstash requires TLS, so use a rediss:// URL. Unset is fine: the worker falls
# back to modal.Dict, and the gateway proxies job status from Modal.
REDIS_URL=

# --- Storage quota (optional) ----------------------------------------------
# Decimal bytes, matching how Cloudflare meters R2. Past the warn threshold the
# gateway refuses dataset uploads with a 507 and the console shows a banner;
# calibration uploads stay allowed. Defaults are the free tier: 10 GB / 9 GB.
# R2_STORAGE_LIMIT_BYTES=10000000000
# R2_STORAGE_WARN_BYTES=9000000000
# How long a bucket-usage total is reused before being recounted (ms), and the
# ceiling on a single object listing.
# R2_USAGE_CACHE_MS=30000
# R2_MAX_LIST_KEYS=20000

# --- Pipeline path overrides (optional) ------------------------------------
# By default the pipeline finds the repo root four levels up from
# pipeline/project_layout.py, i.e. the folder holding Project_Imaging_* and
# output/. Set these only if your data lives elsewhere.
# TOMOPIV_ROOT=/absolute/path/to/Naval
# TOMOPIV_PROJECT_ROOT=/absolute/path/to/Project_Imaging_260709_174128
# TOMOPIV_OUTPUT_ROOT=/absolute/path/to/output
# TOMOPIV_DEFAULT_RUN=LI_16072026_7.2mm_09
